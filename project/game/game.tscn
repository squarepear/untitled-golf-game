[node name="ScoringParagraph2" type="Label" parent="Escape/PanelContainer/MarginContainer/VBoxContainer" unique_id=1715879761]
layout_mode = 2
text = "The ball angle moves along with the camera. Use your mouse to aim the ball. Press the Spacebar to shoot the ball.

The hole moves using WASD. The camera can be controlled using the mouse. The hole will have 5 seconds to finish its turn once it begins moving.


Click to continue game."
