[node name="ScoringParagraph" type="Label" parent="Escape/PanelContainer/MarginContainer/VBoxContainer" unique_id=1913643422]
layout_mode = 2
text = "Balls are scored by normal golf rules: Number of strokes minus par.

Holes receive points based on the final score of the ball. 
- If a ball finishes under par, the hole gains 1 point.
- If a ball finishes over par, the hole will lose 1 point.
- If a ball finishes at par, no points are awarded or deducted.

The player with the fewest points at the end of the game wins!"
autowrap_mode = 3

